---
interface Props {
  current?: 'all' | 'group' | 'diet' | 'family' | string;
}

const { current } = Astro.props;

const navLinks = [
  { id: 'all', label: '🐒 Vue Slider (Tous)', href: '/monkeys/' },
  { id: 'group', label: '🌳 Par Groupe', href: '/monkeys/group/' },
  { id: 'diet', label: '🍃 Par Régime', href: '/monkeys/diet/' },
  { id: 'family', label: '🧬 Par Famille', href: '/monkeys/family/' },
];
---

<nav class="flex flex-wrap items-center justify-center gap-2 my-4 p-2.5 bg-white/90 backdrop-blur-md rounded-2xl border-2 border-purple-300 shadow-sm" aria-label="Navigation des sous-dossiers Singes">
  <span class="text-xs font-bold text-purple-900 uppercase tracking-wider px-2">Filtres Singes :</span>
  <div class="flex flex-wrap items-center gap-1.5">
    {
      navLinks.map((item) => {
        const isActive = current === item.id;
        return (
          <a
            href={item.href}
            class:list={[
              "px-3.5 py-1.5 rounded-full text-xs font-bold transition-all duration-200 border",
              isActive
                ? "bg-purple-600 text-white border-purple-700 shadow-xs scale-105"
                : "bg-white text-slate-700 border-purple-200 hover:bg-purple-100 hover:text-purple-900"
            ]}
          >
            {item.label}
          </a>
        );
      })
    }
  </div>
</nav>

