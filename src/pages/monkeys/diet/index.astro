---
import Layout from "../../../layouts/Layout.astro";
import MonkeyNav from "../../../components/MonkeyNav.astro";
import monkeys from "../../../data/monkeys.json";

const dietList = [...new Set(monkeys.map((m) => m.diet))].sort();

const dietEmoji: Record<string, string> = {
  Omnivore: "🍖",
  Frugivore: "🍌",
  Herbivore: "🌿",
  Folivore: "🍃",
  Gommivore: "🌳",
};
---

<Layout title="Singes par Régime - Routes Dynamiques" activeTab="singes">
  <div class="space-y-8">
    <div class="text-center space-y-3">
      <span class="inline-block px-3 py-1 bg-purple-100 text-purple-900 border border-purple-300 rounded-full text-xs font-bold uppercase tracking-wider">
        TP : Sous-dossier monkeys/diet/
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Singes par <span class="text-pink-600">Régime 🍃</span>
      </h1>
      <p class="text-slate-600 max-w-2xl mx-auto text-sm sm:text-base">
        Liste générée automatiquement : <code>[...new Set(monkeys.map(m => m.diet))]</code>
      </p>
    </div>

    <MonkeyNav current="diet" />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 max-w-4xl mx-auto">
      {dietList.map((diet) => {
        const count = monkeys.filter((m) => m.diet === diet).length;
        const groups = [...new Set(monkeys.filter((m) => m.diet === diet).map((m) => m.group))].join(", ");
        return (
          <a
            href={`/monkeys/diet/${diet}/`}
            class="group rounded-3xl border-2 border-purple-200 bg-white/95 p-6 shadow-sm hover:shadow-lg transition-all duration-300 hover:scale-[1.03] hover:border-purple-400 flex flex-col justify-between"
          >
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-4xl group-hover:scale-110 transition-transform">{dietEmoji[diet] ?? "🍽️"}</span>
                <span class="px-3 py-1 rounded-full bg-purple-50 text-purple-900 border border-purple-200 text-xs font-black">{count} espèce{count > 1 ? "s" : ""}</span>
              </div>
              <h2 class="text-xl font-black text-slate-900 group-hover:text-purple-600 transition-colors">{diet}</h2>
              <p class="text-xs text-slate-500 leading-relaxed">{groups}</p>
            </div>
            <div class="mt-4 flex items-center justify-between text-xs font-bold text-purple-600">
              <span>Voir le graphique</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        );
      })}
    </div>

    <div class="rounded-2xl border border-purple-200 bg-white/80 p-5 shadow-xs max-w-4xl mx-auto">
      <h3 class="font-bold text-slate-800 mb-2 text-sm">Liens directs :</h3>
      <ul class="flex flex-wrap gap-2 text-xs">
        {dietList.map((d) => (
          <li>
            <a href={`/monkeys/diet/${d}/`}
              class="inline-block px-3 py-1.5 rounded-full bg-purple-50 hover:bg-purple-600 text-purple-950 hover:text-white font-semibold transition-colors border border-purple-200">
              {dietEmoji[d] ?? ""} {d}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Layout>

