---
import Layout from "../../layouts/Layout.astro";
import PlotFigure from "../../components/PlotFigure.astro";
import MonkeyNav from "../../components/MonkeyNav.astro";
import monkeys from "../../data/monkeys.json";
import * as Plot from "@observablehq/plot";

// Détermination automatique des groupes
const groupList = [...new Set(monkeys.map((m) => m.group))].sort();

// Couleurs par groupe
const groupColors: Record<string, string> = {
  "Grands Singes": "#e11d48",
  "Petits Singes": "#f59e0b",
  "Singes de l'Ancien Monde": "#8b5cf6",
  "Singes du Nouveau Monde": "#06b6d4",
};

// Graphique de tous les singes (slider = une section par groupe)
function makePlotForGroup(groupName: string, data: typeof monkeys) {
  const filtered = data.filter((m) => m.group === groupName);
  return {
    title: `${groupName}`,
    grid: true,
    width: 720,
    height: 360,
    marginLeft: 60,
    marginBottom: 45,
    inset: 15,
    x: { label: "Poids (kg) →" },
    y: { label: "↑ Taille (cm)" },
    color: {
      legend: true,
      domain: Object.keys(groupColors),
      range: Object.values(groupColors),
    },
    marks: [
      Plot.dot(filtered, {
        x: "weight_kg",
        y: "height_cm",
        fill: "group",
        stroke: "#ffffff",
        strokeWidth: 1.5,
        r: 7,
        fillOpacity: 0.9,
        title: (d: any) =>
          `${d.emoji} ${d.name} (${d.species})\nGroupe: ${d.group}\nRégime: ${d.diet}\nPoids: ${d.weight_kg} kg\nTaille: ${d.height_cm} cm`,
      }),
      Plot.text(filtered, {
        x: "weight_kg",
        y: "height_cm",
        text: (d: any) => d.name,
        dy: -12,
        fontSize: 10,
        fill: "#334155",
      }),
    ],
  };
}
---

<Layout title="Tous les Singes - Slider Dynamique" activeTab="singes">
  <div class="space-y-6">
    <!-- En-tête -->
    <div class="text-center space-y-2">
      <span class="inline-block px-3 py-1 bg-purple-100 text-purple-900 border border-purple-300 rounded-full text-xs font-bold uppercase tracking-wider">
        TP : Rendu par Boucle & [...new Set()]
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Visualisation de tous les <span class="text-pink-600">Singes 🐒</span>
      </h1>
      <p class="text-slate-600 max-w-2xl mx-auto text-sm sm:text-base">
        Graphiques générés dynamiquement par <code>map()</code> sur les groupes extraits via <code>[...new Set()]</code> — {monkeys.length} espèces répertoriées.
      </p>
    </div>

    <!-- Navigation des sous-dossiers -->
    <MonkeyNav current="all" />

    <!-- Sélecteur pour le slider -->
    <div class="sticky top-4 z-20 flex justify-center items-center py-2">
      <div class="flex items-center gap-3 p-3 bg-white/95 backdrop-blur-md rounded-2xl border-2 border-purple-300 shadow-md">
        <label for="group-anchor-select" class="text-xs sm:text-sm font-bold text-purple-900">
          Aller au groupe :
        </label>
        <select
          id="group-anchor-select"
          class="px-3 py-1.5 rounded-xl text-xs sm:text-sm font-semibold bg-white text-slate-800 border border-purple-300 shadow-xs focus:outline-none focus:ring-2 focus:ring-purple-500 cursor-pointer"
        >
          {groupList.map((g) => (
            <option value={g.toLowerCase().replace(/[\s']/g, "-")}>{g}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Slider horizontal — 1 section par groupe (boucle map) -->
    <div
      class="w-full overflow-x-auto overflow-y-hidden scroll-smooth snap-x snap-mandatory rounded-3xl pb-4 pt-1 no-scrollbar"
      id="monkey-slider-wrap"
      tabindex="0"
    >
      <div class="flex gap-8 min-w-full">
        {
          groupList.map((groupName) => {
            const anchor = groupName.toLowerCase().replace(/[\s']/g, "-");
            const groupMembers = monkeys.filter((m) => m.group === groupName);
            const plotOpts = makePlotForGroup(groupName, monkeys);

            return (
              <section
                id={anchor}
                class="item flex-none w-full snap-start snap-always scroll-mt-28 space-y-4"
              >
                <div class="bg-white/80 backdrop-blur-xs p-4 rounded-2xl border border-purple-200/80 flex items-center justify-between">
                  <div>
                    <h2 class="text-xl sm:text-2xl font-black text-slate-900">
                      🐒 {groupName}
                    </h2>
                    <p class="text-xs sm:text-sm text-slate-500">
                      {groupMembers.length} espèce(s) · Groupe extrait automatiquement via <code class="font-mono bg-purple-50 px-1.5 py-0.5 rounded text-purple-700 font-bold">[...new Set()]</code>
                    </p>
                  </div>
                  <a
                    href={`/monkeys/group/${encodeURIComponent(groupName)}/`}
                    class="inline-flex items-center gap-1 text-xs font-bold text-purple-600 hover:text-purple-800 bg-purple-50 hover:bg-purple-100 px-3 py-1.5 rounded-full border border-purple-200 transition-colors"
                  >
                    Page dédiée →
                  </a>
                </div>

                <div class="rounded-3xl border-2 border-purple-200 bg-white/95 p-6 sm:p-8 shadow-sm">
                  <figure class="plot-figure-container flex justify-center items-center overflow-x-auto">
                    <PlotFigure options={plotOpts} />
                  </figure>
                </div>
              </section>
            );
          })
        }
      </div>
    </div>
  </div>
</Layout>

<script>
  const anchorSelect = document.querySelector<HTMLSelectElement>("#group-anchor-select");
  const items = document.querySelectorAll(".item");
  const sliderWrap = document.querySelector("#monkey-slider-wrap");

  anchorSelect?.addEventListener("change", (evt) => {
    const value = (evt.target as HTMLSelectElement).value;
    if (value) location.hash = value;
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && anchorSelect) {
          const id = entry.target.getAttribute("id");
          if (id) anchorSelect.value = id;
        }
      });
    },
    { root: sliderWrap, threshold: 0.5 }
  );

  items.forEach((item) => observer.observe(item));
</script>

