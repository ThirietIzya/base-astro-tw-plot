---
import Layout from "../../../layouts/Layout.astro";
import PlotFigure from "../../../components/PlotFigure.astro";
import MonkeyNav from "../../../components/MonkeyNav.astro";
import monkeys from "../../../data/monkeys.json";
import * as Plot from "@observablehq/plot";

export function getStaticPaths() {
  const groupList = [...new Set(monkeys.map((m) => m.group))];
  return groupList.map((group) => ({ params: { group } }));
}

const { group } = Astro.params;
const allGroups = [...new Set(monkeys.map((m) => m.group))].sort();
const filteredMonkeys = monkeys.filter((m) => m.group === group);

const groupColors: Record<string, string[]> = {
  "Grands Singes": ["#e11d48"],
  "Petits Singes": ["#f59e0b"],
  "Singes de l'Ancien Monde": ["#8b5cf6"],
  "Singes du Nouveau Monde": ["#06b6d4"],
};

const plotOptions = {
  grid: true,
  width: 760,
  height: 420,
  marginLeft: 60,
  marginBottom: 45,
  inset: 15,
  x: { label: "Poids (kg) →" },
  y: { label: "↑ Taille (cm)" },
  color: {
    legend: true,
    domain: Object.keys(groupColors),
    range: Object.values(groupColors).flat(),
  },
  title: `Poids vs Taille — ${group}`,
  subtitle: `${filteredMonkeys.length} espèce(s) dans ce groupe`,
  marks: [
    Plot.dot(filteredMonkeys, {
      x: "weight_kg",
      y: "height_cm",
      fill: "group",
      stroke: "#ffffff",
      strokeWidth: 1.5,
      r: 7,
      fillOpacity: 0.9,
      title: (d: any) =>
        `${d.emoji} ${d.name} (${d.species})\nPoids: ${d.weight_kg} kg\nTaille: ${d.height_cm} cm\nRégime: ${d.diet}\nEspérance: ${d.lifespan_years} ans`,
    }),
    Plot.text(filteredMonkeys, {
      x: "weight_kg",
      y: "height_cm",
      text: (d: any) => d.name,
      dy: -12,
      fontSize: 10,
      fill: "#334155",
    }),
  ],
};
---

<Layout title={`Singes - ${group}`} activeTab="singes">
  <div class="space-y-6">
    <div class="text-center space-y-2">
      <div class="flex items-center justify-center gap-2">
        <a href="/monkeys/group/" class="text-xs font-bold text-purple-600 hover:text-purple-800 bg-purple-50 px-3 py-1 rounded-full border border-purple-200 transition-colors">
          ← Retour aux groupes
        </a>
        <span class="inline-block px-3 py-1 bg-purple-100 text-purple-900 border border-purple-300 rounded-full text-xs font-bold uppercase tracking-wider">
          Route dynamique : /monkeys/group/…
        </span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        <span class="text-pink-600">{group}</span>
      </h1>
      <p class="text-slate-600 font-semibold">{filteredMonkeys.length} espèce(s) dans ce groupe</p>
    </div>

    <MonkeyNav current="group" />

    <!-- Nav rapide entre groupes -->
    <nav class="flex flex-wrap items-center justify-center gap-2 p-2.5 bg-white/90 backdrop-blur-md rounded-2xl border-2 border-purple-300 shadow-sm">
      <span class="text-xs font-bold text-purple-900 px-2 uppercase tracking-wide">Changer de groupe :</span>
      {allGroups.map((g) => (
        <a
          href={`/monkeys/group/${encodeURIComponent(g)}/`}
          class:list={[
            "px-3 py-1.5 rounded-full text-xs font-bold transition-all border",
            g === group
              ? "bg-purple-600 text-white border-purple-700 scale-105"
              : "bg-white text-slate-700 border-purple-200 hover:bg-purple-50 hover:text-purple-900"
          ]}
        >
          {g}
        </a>
      ))}
    </nav>

    <section class="rounded-3xl border-2 border-purple-200 bg-white/95 p-6 sm:p-8 shadow-sm">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-purple-100">
        <h2 class="text-lg font-extrabold text-slate-900">Poids (kg) vs Taille (cm) — {group}</h2>
        <span class="text-xs font-semibold text-slate-500 bg-purple-50 px-2.5 py-1 rounded-full border border-purple-200">Observable Plot</span>
      </div>
      <figure class="plot-figure-container flex justify-center items-center overflow-x-auto">
        <PlotFigure options={plotOptions} />
      </figure>
    </section>

    <!-- Tableau -->
    <div class="rounded-3xl border border-purple-200 bg-white/90 p-5 shadow-xs overflow-x-auto">
      <h3 class="font-extrabold text-slate-900 mb-3 text-sm">🐒 Liste des espèces — {group}</h3>
      <table class="w-full text-left text-xs sm:text-sm text-slate-700">
        <thead>
          <tr class="border-b border-purple-200 bg-purple-50 text-purple-900 font-bold">
            <th class="py-2 px-3">Espèce</th>
            <th class="py-2 px-3">Famille</th>
            <th class="py-2 px-3 text-right">Poids (kg)</th>
            <th class="py-2 px-3 text-right">Taille (cm)</th>
            <th class="py-2 px-3">Régime</th>
            <th class="py-2 px-3">Habitat</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-purple-100">
          {filteredMonkeys.map((m) => (
            <tr class="hover:bg-purple-50/50 transition-colors">
              <td class="py-2 px-3 font-semibold">{m.emoji} {m.name} <span class="text-xs text-slate-400 italic">({m.species})</span></td>
              <td class="py-2 px-3">{m.family}</td>
              <td class="py-2 px-3 text-right font-mono">{m.weight_kg}</td>
              <td class="py-2 px-3 text-right font-mono">{m.height_cm}</td>
              <td class="py-2 px-3"><span class="px-2 py-0.5 rounded-full bg-slate-100 text-xs font-semibold">{m.diet}</span></td>
              <td class="py-2 px-3 text-slate-500">{m.habitat}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Layout>

