---
import Layout from "../../../layouts/Layout.astro";
import MonkeyNav from "../../../components/MonkeyNav.astro";
import monkeys from "../../../data/monkeys.json";

const groupList = [...new Set(monkeys.map((m) => m.group))].sort();

const groupColors: Record<string, string> = {
  "Grands Singes": "border-rose-300 bg-rose-50/60",
  "Petits Singes": "border-amber-300 bg-amber-50/60",
  "Singes de l'Ancien Monde": "border-violet-300 bg-violet-50/60",
  "Singes du Nouveau Monde": "border-cyan-300 bg-cyan-50/60",
};
---

<Layout title="Singes par Groupe - Routes Dynamiques" activeTab="singes">
  <div class="space-y-8">
    <div class="text-center space-y-3">
      <span class="inline-block px-3 py-1 bg-purple-100 text-purple-900 border border-purple-300 rounded-full text-xs font-bold uppercase tracking-wider">
        TP : Sous-dossier monkeys/group/
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Singes par <span class="text-pink-600">Groupe 🌳</span>
      </h1>
      <p class="text-slate-600 max-w-2xl mx-auto text-sm sm:text-base">
        Liste générée automatiquement : <code>[...new Set(monkeys.map(m => m.group))]</code>
      </p>
    </div>

    <MonkeyNav current="group" />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {groupList.map((group) => {
        const count = monkeys.filter((m) => m.group === group).length;
        const families = [...new Set(monkeys.filter((m) => m.group === group).map((m) => m.family))].join(", ");
        const colorClass = groupColors[group] ?? "border-pink-200 bg-pink-50/60";
        return (
          <a
            href={`/monkeys/group/${encodeURIComponent(group)}/`}
            class={`group rounded-3xl border-2 p-6 shadow-sm hover:shadow-lg transition-all duration-300 hover:scale-[1.03] ${colorClass}`}
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-3xl group-hover:scale-110 transition-transform">🐒</span>
                <span class="px-3 py-1 rounded-full bg-white text-slate-800 border border-slate-200 text-xs font-black">
                  {count} espèce{count > 1 ? "s" : ""}
                </span>
              </div>
              <h2 class="text-xl font-black text-slate-900 group-hover:text-pink-600 transition-colors">{group}</h2>
              <p class="text-xs text-slate-500">Familles : {families}</p>
            </div>
            <div class="mt-4 flex items-center justify-between text-xs font-bold text-purple-600 group-hover:text-purple-700">
              <span>Voir le graphique</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        );
      })}
    </div>

    <div class="rounded-2xl border border-purple-200 bg-white/80 p-5 shadow-xs max-w-4xl mx-auto">
      <h3 class="font-bold text-slate-800 mb-2 text-sm">Liens directs :</h3>
      <ul class="flex flex-wrap gap-2 text-xs">
        {groupList.map((g) => (
          <li>
            <a href={`/monkeys/group/${encodeURIComponent(g)}/`}
              class="inline-block px-3 py-1.5 rounded-full bg-purple-50 hover:bg-purple-600 text-purple-950 hover:text-white font-semibold transition-colors border border-purple-200">
              {g}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Layout>

