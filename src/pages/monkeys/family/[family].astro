---
import Layout from "../../../layouts/Layout.astro";
import PlotFigure from "../../../components/PlotFigure.astro";
import MonkeyNav from "../../../components/MonkeyNav.astro";
import monkeys from "../../../data/monkeys.json";
import * as Plot from "@observablehq/plot";

export function getStaticPaths() {
  const familyList = [...new Set(monkeys.map((m) => m.family))];
  return familyList.map((family) => ({ params: { family } }));
}

const { family } = Astro.params;
const allFamilies = [...new Set(monkeys.map((m) => m.family))].sort();
const filteredMonkeys = monkeys.filter((m) => m.family === family);

const plotOptions = {
  grid: true,
  width: 760,
  height: 420,
  marginLeft: 60,
  marginBottom: 45,
  inset: 15,
  x: { label: "Poids (kg) →" },
  y: { label: "↑ Taille (cm)" },
  color: {
    legend: true,
    domain: ["Grands Singes", "Petits Singes", "Singes de l'Ancien Monde", "Singes du Nouveau Monde"],
    range: ["#e11d48", "#f59e0b", "#8b5cf6", "#06b6d4"],
  },
  title: `Famille : ${family}`,
  subtitle: `${filteredMonkeys.length} espèce(s)`,
  marks: [
    Plot.dot(filteredMonkeys, {
      x: "weight_kg",
      y: "height_cm",
      fill: "group",
      stroke: "#ffffff",
      strokeWidth: 1.5,
      r: 8,
      fillOpacity: 0.9,
      title: (d: any) =>
        `${d.emoji} ${d.name} (${d.species})\nGroupe: ${d.group}\nPoids: ${d.weight_kg} kg\nTaille: ${d.height_cm} cm\nRégime: ${d.diet}`,
    }),
    Plot.text(filteredMonkeys, {
      x: "weight_kg",
      y: "height_cm",
      text: (d: any) => `${d.emoji} ${d.name}`,
      dy: -14,
      fontSize: 11,
      fill: "#334155",
    }),
  ],
};
---

<Layout title={`Famille ${family} - Singes`} activeTab="singes">
  <div class="space-y-6">
    <div class="text-center space-y-2">
      <div class="flex items-center justify-center gap-2">
        <a href="/monkeys/family/" class="text-xs font-bold text-purple-600 hover:text-purple-800 bg-purple-50 px-3 py-1 rounded-full border border-purple-200 transition-colors">
          ← Retour aux familles
        </a>
        <span class="inline-block px-3 py-1 bg-purple-100 text-purple-900 border border-purple-300 rounded-full text-xs font-bold uppercase tracking-wider">
          Route dynamique : /monkeys/family/…
        </span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Famille <span class="text-pink-600">{family}</span>
      </h1>
      <p class="text-slate-600 font-semibold">{filteredMonkeys.length} espèce(s) dans cette famille</p>
    </div>

    <MonkeyNav current="family" />

    <nav class="flex flex-wrap items-center justify-center gap-2 p-2.5 bg-white/90 backdrop-blur-md rounded-2xl border-2 border-purple-300 shadow-sm">
      <span class="text-xs font-bold text-purple-900 px-2 uppercase tracking-wide">Changer de famille :</span>
      {allFamilies.map((f) => (
        <a href={`/monkeys/family/${encodeURIComponent(f)}/`}
          class:list={[
            "px-3 py-1.5 rounded-full text-xs font-bold transition-all border",
            f === family
              ? "bg-purple-600 text-white border-purple-700 scale-105"
              : "bg-white text-slate-700 border-purple-200 hover:bg-purple-50 hover:text-purple-900"
          ]}>
          {f}
        </a>
      ))}
    </nav>

    <section class="rounded-3xl border-2 border-purple-200 bg-white/95 p-6 sm:p-8 shadow-sm">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-purple-100">
        <h2 class="text-lg font-extrabold text-slate-900">Poids vs Taille — Famille {family}</h2>
        <span class="text-xs font-semibold text-slate-500 bg-purple-50 px-2.5 py-1 rounded-full border border-purple-200">Observable Plot</span>
      </div>
      <figure class="plot-figure-container flex justify-center items-center overflow-x-auto">
        <PlotFigure options={plotOptions} />
      </figure>
    </section>
  </div>
</Layout>

