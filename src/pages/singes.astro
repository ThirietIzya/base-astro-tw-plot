---
import Layout from '../layouts/Layout.astro';
import PlotFigure from '../components/PlotFigure.astro';
import * as Plot from "@observablehq/plot";
import monkeys from '../data/monkeys.json';

// Graphique 1 : Nuage de points Taille vs Poids des Primates
const scatterOptions = {
  title: "Taille vs Poids selon les Groupes de Primates",
  subtitle: "Comparaison morphologique de 18 espèces de singes",
  caption: "Figure Singes. 1. Nuage de points (Poids en kg vs Taille en cm).",
  ariaLabel: "Nuage de points représentant la taille en fonction du poids des singes",
  grid: true,
  inset: 12,
  width: 760,
  height: 420,
  marginLeft: 60,
  marginBottom: 45,
  x: { label: "Poids moyen (kg) →" },
  y: { label: "↑ Taille moyenne (cm)" },
  color: {
    legend: true,
    domain: ["Grands Singes", "Petits Singes", "Singes de l'Ancien Monde", "Singes du Nouveau Monde"],
    range: ["#e11d48", "#f59e0b", "#8b5cf6", "#06b6d4"]
  },
  marks: [
    Plot.dot(monkeys, {
      x: "weight_kg",
      y: "height_cm",
      fill: "group",
      stroke: "#ffffff",
      strokeWidth: 1.5,
      r: 6,
      fillOpacity: 0.9,
      title: (d) => `${d.name} (${d.species})\nGroupe: ${d.group}\nFamille: ${d.family}\nPoids: ${d.weight_kg}kg\nTaille: ${d.height_cm}cm\nEspérance: ${d.lifespan_years} ans\nRégime: ${d.diet}`
    }),
    Plot.text(monkeys, {
      x: "weight_kg",
      y: "height_cm",
      text: (d) => d.name,
      dy: -12,
      fontSize: 10,
      fill: "#334155"
    })
  ]
};

// Graphique 2 : Barres d'espérance de vie par régime alimentaire
const barOptions = {
  title: "Espérance de Vie moyenne selon le Régime Alimentaire",
  subtitle: "Moyenne des années de vie observées en milieu naturel / protégé",
  caption: "Figure Singes. 2. Diagramme en barres horizontales.",
  ariaLabel: "Diagramme en barres de l'espérance de vie par régime alimentaire",
  grid: true,
  width: 760,
  height: 280,
  marginLeft: 90,
  marginBottom: 40,
  x: { label: "Espérance de vie moyenne (années) →" },
  y: { label: "Régime" },
  color: {
    scheme: "purples"
  },
  marks: [
    Plot.barX(monkeys, Plot.groupY({ x: "mean" }, {
      x: "lifespan_years",
      y: "diet",
      fill: "diet",
      sort: { y: "x", reverse: true }
    })),
    Plot.ruleX([0])
  ]
};

const totalSpecies = monkeys.length;
const maxWeightMonkey = monkeys.reduce((prev, curr) => (curr.weight_kg > prev.weight_kg ? curr : prev), monkeys[0]);
const minWeightMonkey = monkeys.reduce((prev, curr) => (curr.weight_kg < prev.weight_kg ? curr : prev), monkeys[0]);
---

<Layout title="Base de données Primates & Singes" activeTab="singes">
  <div class="space-y-8">
    <!-- En-tête -->
    <div class="text-center space-y-3">
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Les Primates & <span class="text-pink-600">Singes 🐒</span>
      </h1>
      <p class="text-slate-600 max-w-2xl mx-auto text-sm sm:text-base">
        Explorez nos données comparatives sur <strong>{totalSpecies} espèces de primates</strong> à travers le monde : Grands Singes, Gibbons, Cercopithèques et Singes du Nouveau Monde.
      </p>
    </div>

    <!-- Statistiques Clés -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-4xl mx-auto">
      <div class="p-4 bg-white/90 rounded-2xl border border-pink-200 shadow-xs text-center space-y-1">
        <span class="text-2xl">🌍</span>
        <div class="text-2xl font-black text-pink-600">{totalSpecies}</div>
        <div class="text-xs font-bold text-slate-500 uppercase tracking-wide">Espèces répertoriées</div>
      </div>
      <div class="p-4 bg-white/90 rounded-2xl border border-pink-200 shadow-xs text-center space-y-1">
        <span class="text-2xl">{maxWeightMonkey.emoji}</span>
        <div class="text-2xl font-black text-purple-600">{maxWeightMonkey.weight_kg} kg</div>
        <div class="text-xs font-bold text-slate-500 uppercase tracking-wide">Plus lourd : {maxWeightMonkey.name}</div>
      </div>
      <div class="p-4 bg-white/90 rounded-2xl border border-pink-200 shadow-xs text-center space-y-1">
        <span class="text-2xl">{minWeightMonkey.emoji}</span>
        <div class="text-2xl font-black text-pink-500">{minWeightMonkey.weight_kg * 1000} g</div>
        <div class="text-xs font-bold text-slate-500 uppercase tracking-wide">Plus léger : {minWeightMonkey.name}</div>
      </div>
    </div>

    <!-- Graphique 1 : Scatter plot -->
    <section class="rounded-3xl border-2 border-pink-200 bg-white/95 p-6 sm:p-8 shadow-sm">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-pink-100">
        <h2 class="text-lg sm:text-xl font-extrabold text-slate-900">
          Morphologie : Poids (kg) vs Taille (cm)
        </h2>
        <span class="text-xs font-semibold text-slate-500 bg-pink-50 px-2.5 py-1 rounded-full border border-pink-200">
          Observable Plot
        </span>
      </div>
      <figure class="plot-figure-container flex justify-center items-center overflow-x-auto">
        <PlotFigure options={scatterOptions} />
      </figure>
    </section>

    <!-- Graphique 2 : Espérance de vie par régime -->
    <section class="rounded-3xl border-2 border-purple-200 bg-white/95 p-6 sm:p-8 shadow-sm">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-purple-100">
        <h2 class="text-lg sm:text-xl font-extrabold text-slate-900">
          Espérance de vie par régime alimentaire
        </h2>
        <span class="text-xs font-semibold text-purple-700 bg-purple-50 px-2.5 py-1 rounded-full border border-purple-200">
          Diagramme Barres
        </span>
      </div>
      <figure class="plot-figure-container flex justify-center items-center overflow-x-auto">
        <PlotFigure options={barOptions} />
      </figure>
    </section>

    <!-- Tableau récapitulatif -->
    <div class="rounded-3xl border border-pink-200 bg-white/90 p-5 shadow-xs overflow-x-auto">
      <h3 class="font-extrabold text-slate-900 mb-3 text-sm sm:text-base">📋 Liste complète des espèces</h3>
      <table class="w-full text-left text-xs sm:text-sm text-slate-700">
        <thead>
          <tr class="border-b border-pink-200 bg-pink-50 text-pink-900 font-bold">
            <th class="py-2 px-3">Espèce</th>
            <th class="py-2 px-3">Groupe</th>
            <th class="py-2 px-3">Famille</th>
            <th class="py-2 px-3 text-right">Poids (kg)</th>
            <th class="py-2 px-3 text-right">Taille (cm)</th>
            <th class="py-2 px-3">Régime</th>
            <th class="py-2 px-3">Habitat</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-pink-100">
          {monkeys.map((m) => (
            <tr class="hover:bg-pink-50/50 transition-colors">
              <td class="py-2 px-3 font-semibold text-slate-900">
                {m.emoji} {m.name} <span class="text-xs font-normal text-slate-500 italic">({m.species})</span>
              </td>
              <td class="py-2 px-3">{m.group}</td>
              <td class="py-2 px-3">{m.family}</td>
              <td class="py-2 px-3 text-right font-mono">{m.weight_kg}</td>
              <td class="py-2 px-3 text-right font-mono">{m.height_cm}</td>
              <td class="py-2 px-3"><span class="px-2 py-0.5 rounded-full bg-slate-100 text-xs font-semibold">{m.diet}</span></td>
              <td class="py-2 px-3 text-slate-600">{m.habitat}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Layout>

