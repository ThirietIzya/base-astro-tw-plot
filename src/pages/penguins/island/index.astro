---
import Layout from "../../../layouts/Layout.astro";
import PenguinNav from "../../../components/PenguinNav.astro";
import penguins from "../../../data/penguins.json";

// Détermination automatique des îles
const islands = [...new Set(penguins.map((p) => p.island))].sort();

const islandDetails: Record<string, { emoji: string; desc: string }> = {
  Biscoe: { emoji: "🏔️", desc: "Île principale hébergeant une grande diversité d'espèces (notamment Gentoo et Adelie)." },
  Dream: { emoji: "🌊", desc: "Île volcanique abritant des colonies de manchots Chinstrap et Adelie." },
  Torgersen: { emoji: "❄️", desc: "Petite île rocheuse près de la station Palmer, peuplée exclusivement d'Adelie." },
};
---

<Layout title="Îles Palmer - Routes Dynamiques" activeTab="penguins">
  <div class="space-y-8">
    <!-- En-tête -->
    <div class="text-center space-y-3">
      <span class="inline-block px-3 py-1 bg-pink-100 text-pink-800 border border-pink-300 rounded-full text-xs font-bold uppercase tracking-wider">
        TP : Sous-dossier penguins/island/
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Manchots par <span class="text-pink-600">Île 🏝️</span>
      </h1>
      <p class="text-slate-600 max-w-2xl mx-auto text-sm sm:text-base">
        Liste générée automatiquement par <code>[...new Set(penguins.map(p => p.island))]</code>.
      </p>
    </div>

    <!-- Navigation des sous-dossiers -->
    <PenguinNav current="island" />

    <!-- Cartes des îles -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
      {
        islands.map((island) => {
          const count = penguins.filter((p) => p.island === island).length;
          const speciesOnIsland = [...new Set(penguins.filter((p) => p.island === island).map((p) => p.species))].join(", ");
          const detail = islandDetails[island] ?? { emoji: "🏝️", desc: "Île de l'archipel Palmer" };

          return (
            <a
              href={`/penguins/island/${island}/`}
              class="group rounded-3xl border-2 border-pink-200 bg-white/95 p-6 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between hover:scale-[1.03] hover:border-pink-400"
            >
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-4xl group-hover:scale-110 transition-transform">{detail.emoji}</span>
                  <span class="px-3 py-1 rounded-full bg-pink-50 text-pink-900 border border-pink-200 text-xs font-black">
                    {count} manchots
                  </span>
                </div>
                <h2 class="text-2xl font-black text-slate-900 group-hover:text-pink-600 transition-colors">
                  Île {island}
                </h2>
                <p class="text-xs text-slate-600 leading-relaxed">
                  {detail.desc}
                </p>
                <div class="pt-2">
                  <span class="text-xs font-bold text-slate-500">Espèces présentes :</span>
                  <p class="text-xs font-semibold text-pink-700">{speciesOnIsland}</p>
                </div>
              </div>

              <div class="mt-6 flex items-center justify-between text-xs font-bold text-pink-600 group-hover:text-pink-700">
                <span>Voir les données de l'île</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          );
        })
      }
    </div>

    <!-- Liens directs -->
    <div class="rounded-2xl border border-pink-200 bg-white/80 p-5 shadow-xs max-w-4xl mx-auto">
      <h3 class="font-bold text-slate-800 mb-2 text-sm">Liens directs vers les routes dynamiques :</h3>
      <ul class="flex flex-wrap gap-2 text-xs">
        {
          islands.map((isl) => (
            <li>
              <a
                href={`/penguins/island/${isl}/`}
                class="inline-block px-3 py-1.5 rounded-full bg-pink-50 hover:bg-pink-600 text-pink-950 hover:text-white font-semibold transition-colors border border-pink-200"
              >
                /penguins/island/{isl}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Layout>

