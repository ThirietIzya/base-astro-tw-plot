---
import Layout from "../../../layouts/Layout.astro";
import PenguinNav from "../../../components/PenguinNav.astro";
import penguins from "../../../data/penguins.json";

// Déterminer automatiquement la liste des espèces par map et new Set()
const speciesList = [...new Set(penguins.map((p) => p.species))].sort();

const speciesDetails: Record<string, { emoji: string; color: string; desc: string }> = {
  Adelie: { emoji: "🟧", color: "border-orange-300 bg-orange-50/60", desc: "Manchots Adélie (Pygoscelis adeliae) - Les plus communs" },
  Gentoo: { emoji: "🟦", color: "border-sky-300 bg-sky-50/60", desc: "Manchots Papous (Pygoscelis papua) - Les plus grands" },
  Chinstrap: { emoji: "🟪", color: "border-purple-300 bg-purple-50/60", desc: "Manchots à jugulaire (Pygoscelis antarcticus) - Bande noire sous le menton" },
};
---

<Layout title="Espèces de Manchots - Routes Dynamiques" activeTab="penguins">
  <div class="space-y-8">
    <!-- En-tête -->
    <div class="text-center space-y-3">
      <span class="inline-block px-3 py-1 bg-pink-100 text-pink-800 border border-pink-300 rounded-full text-xs font-bold uppercase tracking-wider">
        TP : Sous-dossier penguins/specie/
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Manchots par <span class="text-pink-600">Espèce</span>
      </h1>
      <p class="text-slate-600 max-w-2xl mx-auto text-sm sm:text-base">
        Liste générée automatiquement par <code>map()</code> et <code>[...new Set()]</code>. Cliquez sur une espèce pour accéder à sa page dynamique <code>/penguins/specie/[species]</code>.
      </p>
    </div>

    <!-- Navigation des sous-dossiers -->
    <PenguinNav current="specie" />

    <!-- Cartes des espèces -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
      {
        speciesList.map((species) => {
          const count = penguins.filter((p) => p.species === species).length;
          const detail = speciesDetails[species] ?? { emoji: "🐧", color: "border-pink-300 bg-pink-50/60", desc: "Espèce de manchot" };

          return (
            <a
              href={`/penguins/specie/${species}/`}
              class={`group rounded-3xl border-2 p-6 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between hover:scale-[1.03] ${detail.color}`}
            >
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-4xl group-hover:scale-110 transition-transform">{detail.emoji}</span>
                  <span class="px-3 py-1 rounded-full bg-white text-slate-800 border border-slate-200 text-xs font-black shadow-2xs">
                    {count} individus
                  </span>
                </div>
                <h2 class="text-2xl font-black text-slate-900 group-hover:text-pink-600 transition-colors">
                  {species}
                </h2>
                <p class="text-xs text-slate-600 leading-relaxed">
                  {detail.desc}
                </p>
              </div>

              <div class="mt-6 flex items-center justify-between text-xs font-bold text-pink-600 group-hover:text-pink-700">
                <span>Voir le graphique dynamique</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          );
        })
      }
    </div>

    <!-- Liste standard du TD -->
    <div class="rounded-2xl border border-pink-200 bg-white/80 p-5 shadow-xs max-w-4xl mx-auto">
      <h3 class="font-bold text-slate-800 mb-2 text-sm">Liens directs générés par boucle :</h3>
      <ul class="flex flex-wrap gap-2 text-xs">
        {
          speciesList.map((sp) => (
            <li>
              <a
                href={`/penguins/specie/${sp}/`}
                class="inline-block px-3 py-1.5 rounded-full bg-pink-50 hover:bg-pink-600 text-pink-950 hover:text-white font-semibold transition-colors border border-pink-200"
              >
                /penguins/specie/{sp}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Layout>

